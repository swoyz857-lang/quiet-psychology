{
  "name": "quiet-psychology",
  "version": "1.0.0",
  "private": true,
  "description": "Premium behavioral intelligence publishing platform",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:init": "cd backend && npx tsx src/index.ts --init",
    "db:seed": "cd backend && npx tsx src/index.ts --seed",
    "generate:downloads": "node scripts/generate-downloads.js",
    "start": "cd backend && npm run start"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "pdf-lib": "^1.17.1",
    "turbo": "^2.0.0"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
